# Ejemplo de variables de entorno para el proyecto
# Copiar a .env y rellenar con tus valores

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================

# Motor de BD: "sqlite" (default) o "postgresql"
DB_ENGINE=sqlite

# Para PostgreSQL:
DB_NAME=clinica
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432

# Ruta de base de datos (solo para SQLite)
DB_PATH=data/clinica.db

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
